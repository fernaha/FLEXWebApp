@{
    ViewData["Title"] = "Home Page";
}

<!-- Include SignalR Client Library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    // 1. Establish the connection to the route mapped in Program.cs
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/lineMonitorHub")
        .withAutomaticReconnect()
        .build();

    // 2. Register event listener matching the target string pushed by IHubContext
    connection.on("ReceiveLiveData", function (data) {
        console.log("Live update received:", data);
        // Code to update DOM elements live
    });

    // 3. Start the connection
    connection.start()
        .then(() => console.log("SignalR Connected!"))
        .catch(err => console.error(err.toString()));
</script>
