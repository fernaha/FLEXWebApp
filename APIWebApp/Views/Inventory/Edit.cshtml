@model APIWebApp.Models.InventoryItem
@{
    ViewData["Title"] = "Edit Item";
}

<h2>Edit Item</h2>

<form method="post" asp-controller="Inventory" asp-action="Edit" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" name="Name" value="@Model.Name" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" name="Description">@Model.Description</textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Stock Count</label>
        <input type="number" class="form-control" name="StockCount" value="@Model.StockCount" />
    </div>
    <div class="mb-3">
        <label class="form-label">Image (optional)</label>
        <input type="file" class="form-control" name="image" />
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="mt-2">
                <img src="@Model.ImagePath" style="max-height:150px;" />
            </div>
        }
    </div>
    <button class="btn btn-primary">Save</button>
</form>
